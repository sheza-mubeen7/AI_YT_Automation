    {
      "parameters": {
        "jsCode": "const output = $input.first().json.content.parts[0].text;\nconst parsed = typeof output === 'string' ? JSON.parse(output.trim()) : output;\n\nconst introText = parsed.introText;\n\nreturn parsed.clips.map((clip, index) => ({\n  json: {\n    introText: introText,\n    clipNumber: index + 1,\n    voiceText: clip.voiceText,\n    image_prompt: clip.image_prompt\n  }\n}));"
      },
