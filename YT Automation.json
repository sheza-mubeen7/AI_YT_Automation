    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst introText = items[0].json.introText;\n\nconst clips = items.map(item => ({\n  voiceText: item.json.voiceText,\n  image_prompt: item.json.image_prompt\n}));\n\nreturn [{\n  json: {\n    template: \"OOBCbrvfCvPH7heO3mdb\",\n    variables: {\n      introText: introText,\n      clips: clips\n    }\n  }\n}];"
      },
