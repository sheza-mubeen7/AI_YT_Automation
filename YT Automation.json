    {
      "parameters": {
        "jsCode": "const parts = $input.first().json.content.parts;\nlet raw = parts.map(p => p.text || '').join('').trim();\n\n// Remove markdown code fences if present\nraw = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '');\n\nconst ideas = JSON.parse(raw);\n\nreturn ideas.map(item => ({\n  json: {\n    idea: item.idea,\n    caption: item.caption,\n    channel_style: item.channel_style,\n    prompt: item.prompt,\n    character_style: item.character_style,\n    status: item.status\n  }\n}));"
      },
